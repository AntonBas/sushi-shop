# =====================================================
# SUSHI SHOP ENVIRONMENT
# =====================================================
# Template for .env. The variables needed depend on the Spring profile:
#
#   local  — ./gradlew bootRun (default for bootRun, see build.gradle)
#            Postgres/Redis in Docker, app on the host.
#   docker — docker compose up -d
#            Everything in Docker.
#   prod   — Render + Neon + Upstash; SPRING_PROFILES_ACTIVE=prod and all
#            values are set in the Render dashboard, not in this file.
#
# Monitoring and tunnel (prometheus, grafana, ngrok):
#   docker compose --profile dev up -d
# =====================================================

# ---- All profiles ----

JWT_SECRET=your_jwt_secret_here

BREVO_API_KEY=your_brevo_api_key_here
MAIL_FROM_EMAIL=sushi.bas.shop@gmail.com

GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret

STRIPE_SECRET_KEY=your_stripe_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Public frontend URL: OAuth2 redirect target and default CORS origin.
# Locally the frontend and backend share one origin (Vite/nginx proxy).
APP_BASE_URL=http://localhost:5173

PROMETHEUS_USER=prometheus
PROMETHEUS_PASSWORD=your_prometheus_password_here

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ---- local / docker ----

DB_HOST=localhost
DB_PORT=5433
DB_NAME=sushi_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here

REDIS_HOST=localhost
REDIS_PORT=6379

# Demo accounts from the README, local environment only.
SEED_DEMO_USERS=false

# Public tunnel for Stripe webhooks during local development.
NGROK_AUTH_TOKEN=your_token_here

# ---- prod (Render dashboard) ----

# SPRING_PROFILES_ACTIVE=prod

# Neon
# DB_HOST=ep-xxxx.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_NAME=sushi_db
# DB_USER=your_neon_user
# DB_PASSWORD=your_neon_password

# Upstash (TLS)
# REDIS_URL=rediss://default:your_password@your-instance.upstash.io:6379

# Cloudinary (product images)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Backend URL, used for the Google OAuth callback
# (<APP_BASE_URL>/login/oauth2/code/google in Google Cloud Console).
# APP_BASE_URL=https://sushi-shop-backend.onrender.com

# Frontend URL the browser returns to after OAuth login.
# FRONTEND_URL=https://sushi-shop.vercel.app

# Allowed CORS origins, comma-separated, exact origins.
# CORS_ALLOWED_ORIGINS=https://sushi-shop.vercel.app

# Set by Render.
# PORT=10000

# Vercel project env var for the frontend build.
# VITE_API_URL=https://sushi-shop-backend.onrender.com

# =====================================================
# WHERE THE VALUES COME FROM
# =====================================================
# DB_PASSWORD      - any password
# JWT_SECRET       - openssl rand -base64 32
# BREVO_API_KEY    - https://app.brevo.com (Settings -> SMTP & API -> API Keys);
#                    MAIL_FROM_EMAIL is a verified sender there
#                    (Senders, Domains & Dedicated IPs -> Senders), no domain needed
# GOOGLE_*         - https://console.cloud.google.com/apis/credentials
# STRIPE_*         - https://dashboard.stripe.com/test/apikeys
# CLOUDINARY_*     - https://console.cloudinary.com (Dashboard page)
# NGROK_AUTH_TOKEN - https://dashboard.ngrok.com/get-started/your-authtoken
# PROMETHEUS_*     - credentials for /actuator/prometheus
# =====================================================
