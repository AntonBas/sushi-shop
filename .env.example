# =====================================================
# SUSHI SHOP ENVIRONMENT
# =====================================================
# Copy to .env and fill in values. Which variables you need depends on
# how you run the backend (Spring profile):
#
#   local  — ./gradlew bootRun (default profile for bootRun, see build.gradle)
#            Postgres/Redis in Docker, app runs on the host.
#   docker — docker compose up -d
#            Everything in Docker, container-to-container networking.
#   prod   — cloud deployment (Render + Neon + Upstash), SPRING_PROFILES_ACTIVE=prod
#            set as an env var on the hosting platform, not from this file.
#
# Local dev with monitoring/tunnel (prometheus, grafana, ngrok):
#   docker compose --profile dev up -d
# =====================================================

# ---- Required everywhere (local, docker, prod) ----

JWT_SECRET=your_jwt_secret_here

EMAIL_USERNAME=sushi.bas.shop@gmail.com
EMAIL_PASSWORD=your_app_password_here

GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret

STRIPE_SECRET_KEY=your_stripe_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Public URL of the frontend (used as the OAuth2 redirect target and, unless
# overridden below, as the CORS-allowed origin). For local/docker this is
# the same origin as the backend (same-origin via Vite/nginx proxy).
APP_BASE_URL=http://localhost:5173

PROMETHEUS_USER=prometheus
PROMETHEUS_PASSWORD=changeme

# ---- local / docker only ----

DB_HOST=localhost
DB_PORT=5433
DB_NAME=sushi_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here

REDIS_HOST=localhost
REDIS_PORT=6379

# Seeds admin@test.com / admin (+ courier, user) on startup. Leave false
# unless you need the demo accounts locally — never enable this on a
# publicly reachable deployment.
SEED_DEMO_USERS=false

# docker profile only — local Stripe webhook testing via a public tunnel.
NGROK_AUTH_TOKEN=your_token_here

# ---- prod only (Render + Neon + Upstash) ----
# Not read from this file on Render — set these directly in the Render
# dashboard's environment variables, alongside the "required everywhere"
# ones above. Listed here for reference.

# SPRING_PROFILES_ACTIVE=prod

# Neon connection details (sslmode=require is hardcoded in application-prod.yml).
# DB_HOST=ep-xxxx.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_NAME=sushi_db
# DB_USER=your_neon_user
# DB_PASSWORD=your_neon_password

# Upstash gives a full rediss:// (TLS) URL.
# REDIS_URL=rediss://default:your_password@your-instance.upstash.io:6379

# Cloudinary — product images go here instead of local disk, since Render's
# filesystem is wiped on every redeploy. Values from the Cloudinary dashboard.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Render's own public URL — used as the Google OAuth callback (redirect-uri).
# Must also be added to Google Cloud Console's Authorized redirect URIs as
# <APP_BASE_URL>/login/oauth2/code/google.
# APP_BASE_URL=https://sushi-backend.onrender.com

# Vercel frontend URL — where the browser is redirected after OAuth login.
# FRONTEND_URL=https://sushi-shop.vercel.app

# CORS-allowed origin(s), comma-separated. Supports wildcard patterns
# (matched via Spring's setAllowedOriginPatterns) — useful because every
# Vercel preview deploy gets its own random subdomain, not just the
# production URL above. A pattern like https://sushi-shop*.vercel.app
# covers both the production domain and every preview deployment.
# CORS_ALLOWED_ORIGINS=https://sushi-shop*.vercel.app

# Render sets this automatically — no need to set it yourself.
# PORT=10000

# frontend/.env.production (or a Vercel project env var, NOT this file) —
# the frontend build needs the backend's URL since there's no nginx proxy
# on Vercel:
# VITE_API_URL=https://sushi-backend.onrender.com

# =====================================================
# WHERE TO GET VALUES:
# =====================================================
# DB_PASSWORD      - any password
# JWT_SECRET       - run: openssl rand -base64 32
# EMAIL_PASSWORD   - https://myaccount.google.com/apppasswords
# GOOGLE_*         - https://console.cloud.google.com/apis/credentials
# STRIPE_*         - https://dashboard.stripe.com/test/apikeys
# CLOUDINARY_*     - https://console.cloudinary.com (Dashboard page, top)
# NGROK_AUTH_TOKEN - https://dashboard.ngrok.com/get-started/your-authtoken
# PROMETHEUS_*     - credentials for scraping /actuator/prometheus; rendered
#                    into prometheus.yml automatically at startup by the
#                    prometheus-config service (envsubst over
#                    prometheus.yml.template), no manual sync needed
# =====================================================
